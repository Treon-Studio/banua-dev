---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const tiers = [
  {
    name: "Community Member",
    price: "Gratis",
    suffix: "akses dasar",
    description:
      "Bergabung dengan komunitas online. Akses Discord, Telegram, dan newsletter bulanan.",
    features: [
      "Akses Discord dan Telegram komunitas",
      "Newsletter bulanan dengan update terbaru",
      "Akses rekaman meetup dan workshop",
    ],
    action: { label: "Gabung Gratis", variant: "muted" },
    note: "Registrasi diperlukan",
  },
  {
    name: "Event Pass",
    price: "Rp 50K",
    suffix: "per event",
    description:
      "Ikuti meetup atau workshop offline. Cocok untuk yang ingin belajar topik spesifik.",
    features: [
      "Akses ke satu event offline",
      "Networking dengan peserta lain",
      "Snack dan minuman",
    ],
    action: { label: "Lihat Event", variant: "muted" },
  },
  {
    name: "Workshop Pass",
    price: "Rp 150K",
    suffix: "full day workshop",
    description:
      "Workshop intensif seharian dengan hands-on practice dan project nyata.",
    features: [
      "Workshop full day (6-8 jam)",
      "Materi dan resource lengkap",
      "Sertifikat kehadiran",
    ],
    action: { label: "Daftar Workshop", variant: "default" },
    highlight: true,
    tag: "Recommended",
  },
  {
    name: "Annual Member",
    price: "Rp 500K",
    suffix: "per tahun",
    description:
      "Membership tahunan dengan akses ke semua event dan benefit eksklusif.",
    features: [
      "Akses gratis ke semua meetup",
      "Diskon 50% untuk workshop",
      "Akses eksklusif ke mentoring session",
    ],
    action: {
      label: "Jadi Member",
      variant: "muted",
    },
    note: "Kuota terbatas",
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-32">
      <div>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight"
        >
          Event & Membership
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
        >
          Pilih opsi yang sesuai dengan kebutuhanmu. Mulai dari akses gratis
          ke komunitas online hingga membership tahunan dengan berbagai benefit.
        </Text>
      </div>
      <div
        class="grid grid-cols-1 lg:grid-cols-4 mt-12 lg:divide-x lg:divide-dashed lg:divide-black/20"
      >
        {
          tiers.map((tier) => (
            <div class="group relative flex h-full flex-col justify-between bg-dark-green px-6 py-10 transition duration-200 hover:border-white/30 sm:px-8">
              <div>
                <div class="flex flex-col">
                  <div>
                    <Text
                      tag="p"
                      variant="textXL"
                      class="font-display  text-white flex items-center justify-between gap-2"
                    >
                      {tier.price}
                      {tier.tag && (
                        <span class="text-sm uppercase   text-white">
                          {tier.tag}
                        </span>
                      )}
                    </Text>
                    <Text
                      tag="p"
                      variant="textXS"
                      class="text-base-200 uppercase"
                    >
                      {tier.suffix}
                    </Text>
                  </div>
                  <Text
                    tag="h3"
                    variant="textXL"
                    class="font-display  uppercase text-white mt-8"
                  >
                    {tier.name}
                  </Text>
                  <Text tag="p" variant="textSM" class="text-base-200 mt-1">
                    {tier.description}
                  </Text>
                </div>
                <ul
                  class="space-y-1 mt-8 list-disc ml-4 text-white"
                  role="list"
                >
                  {tier.features.map((feature) => (
                    <li>
                      <Text tag="span" variant="textSM" class="text-base-200">
                        {feature}
                      </Text>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mt-10 space-y-3">
                {tier.note && (
                  <Text
                    tag="p"
                    variant="textSM"
                    class="text-center text-white"
                  >
                    {tier.note}
                  </Text>
                )}
                <Button
                  size="base"
                  variant={tier.action.variant}
                  class="w-full"
                >
                  {tier.action.label}
                </Button>
              </div>
            </div>
          ))
        }
      </div>
      <div
        class="flex flex-wrap items-center justify-between gap-4 border-t border-black/10 pt-6"
      >
        <Text tag="p" variant="textXS" class="uppercase text-base-600">
          Harga sudah termasuk materi & konsumsi
        </Text>
        <Text tag="p" variant="textXS" class="text-base-600">
          Ada pertanyaan? <Button
            variant="link"
            href="mailto:hello@banuadev.com">Hubungi tim BanuaDev</Button
          >
        </Text>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
