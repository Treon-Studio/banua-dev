---
// Assets
import { Image } from "astro:assets";
import venue from "@/images/assets/venue.jpg";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const spaces = [
  {
    title: "Main Hall",
    description:
      "Ruang utama untuk meetup dan talk. Kapasitas 100+ orang dengan proyektor, sound system, dan live streaming setup.",
  },
  {
    title: "Workshop Room",
    description:
      "Ruang workshop dengan meja dan kursi yang bisa diatur fleksibel. Tersedia whiteboard, monitor, dan koneksi internet cepat.",
  },
  {
    title: "Networking Area",
    description:
      "Area santai untuk networking dan diskusi informal. Tersedia kopi, snack, dan suasana yang nyaman untuk ngobrol.",
  },
];
const transit = [
  "Tersedia parkir motor dan mobil di area venue",
  "Akses mudah dari transportasi umum",
  "Lokasi strategis di pusat kota",
];
const accessibility = [
  "Akses ramah disabilitas",
  "Toilet dan fasilitas lengkap",
  "AC dan ventilasi yang baik",
];
const nearbyStays = [
  "Berbagai pilihan hotel dan penginapan di sekitar venue",
  "Akses mudah ke restoran dan cafe",
  "Area parkir yang luas",
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-32">
      <header class="max-w-4xl space-y-4">
        <Text tag="p" variant="textXS" class="uppercase text-base-600">
          Lokasi
        </Text>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight mt-8"
        >
          Venue Event
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
        >
          Event BanuaDev diadakan di berbagai lokasi di Indonesia. Venue dipilih
          dengan pertimbangan akses, fasilitas, dan kenyamanan untuk semua peserta.
        </Text>
      </header>
      <section>
        <div class="grid lg:grid-cols-12 mt-12">
          <div class="lg:col-span-6">
            <Image
              src={venue}
              alt="Venue"
              width={1200}
              height={800}
              loading="eager"
              decoding="async"
            />
          </div>
          <aside class="flex flex-col gap-8 lg:col-span-5 lg:col-start-8">
            <div class="space-y-3">
              <Text
                tag="h3"
                variant="textBase"
                class="font-display uppercase text-black"
              >
                Lokasi Utama
              </Text>
              <address
                aria-label="Venue address"
                class="not-italic space-y-1"
              >
                <Text tag="p" variant="textSM" class="text-base-600">
                  Lokasi venue akan diumumkan
                </Text>
                <Text tag="p" variant="textSM" class="text-base-600">
                  sebelum setiap event
                </Text>
                <Text tag="p" variant="textSM" class="text-base-600">
                  Indonesia
                </Text>
              </address>
            </div>
            <div class="space-y-3">
              <Text
                tag="h3"
                variant="textBase"
                class="font-display uppercase text-black"
              >
                Akses
              </Text>
              <ul
                class="text-base-600 text-sm divide-y divide-dashed divide-black/10"
              >
                {transit.map((item) => <li class="py-2">{item}</li>)}
              </ul>
            </div>
            <div class="space-y-3">
              <Text
                tag="h3"
                variant="textBase"
                class="font-display uppercase text-black"
              >
                Fasilitas
              </Text>
              <ul
                class="text-base-600 text-sm divide-y divide-dashed divide-black/10"
              >
                {accessibility.map((item) => <li class="py-2">{item}</li>)}
              </ul>
            </div>
            <div class="space-y-3">
              <Text
                tag="h3"
                variant="textBase"
                class="font-display uppercase text-black"
              >
                Sekitar Venue
              </Text>
              <ul
                class="text-base-600 text-sm divide-y divide-dashed divide-black/10"
              >
                {nearbyStays.map((item) => <li class="py-2">{item}</li>)}
              </ul>
            </div>
          </aside>
        </div>
        <div class="mt-8">
          <Text
            tag="h2"
            variant="displaySM"
            class="text-balance text-black font-display uppercase leading-tight"
          >
            Ruang yang Nyaman untuk Belajar
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
          >
            Venue kami dirancang untuk mendukung berbagai format event, dari
            talk session hingga hands-on workshop. Fasilitas lengkap untuk
            memastikan pengalaman belajar yang optimal.
          </Text>
        </div>
        <div
          class="grid grid-cols-1 items-start gap-y-12 xl:grid-cols-12 mt-12"
        >
          {
            spaces.map((space) => (
              <article class="[&:nth-child(1)]:lg:col-start-3 [&:nth-child(2)]:lg:col-start-6 relative  lg:col-span-3 ">
                <Text
                  tag="h3"
                  variant="textXL"
                  class="text-black  font-display uppercase"
                >
                  {space.title}
                </Text>
                <Text tag="p" variant="textBase" class="text-base-500 ">
                  {space.description}
                </Text>
              </article>
            ))
          }
        </div>
      </section>
      <section
        class="gap-x-12 gap-y-8 border border-white/10 bg-accent-500 p-8 md:flex md:items-center md:justify-between mt-24"
      >
        <div class="max-w-2xl space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-white"
          >
            Info Event Selanjutnya
          </Text>
          <Text tag="p" variant="textSM" class="text-base-200 lg:text-balance">
            Cek jadwal event terbaru dan daftar sekarang. Ada pertanyaan tentang
            venue? Hubungi kami di <a
              class="underline"
              href="mailto:hello@banuadev.com">hello@banuadev.com</a
            >.
          </Text>
        </div>
        <div
          class="flex flex-wrap items-center justify-center gap-2 md:justify-end"
        >
          <Button
            size="sm"
            variant="default"
            class="w-fit"
            href="/schedule"
          >
            Lihat Jadwal
          </Button>
          <Button
            size="sm"
            variant="muted"
            class="w-fit"
            href="/forms/contact"
          >
            Hubungi Kami
          </Button>
        </div>
      </section>
    </Wrapper>
  </section>
</BaseLayout>
