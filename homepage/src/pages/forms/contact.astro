---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-32">
      <div>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight"
        >
          Hubungi Tim BanuaDev
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
        >
          Punya pertanyaan tentang event, sponsorship, atau ingin kolaborasi?
          Kami siap membantu. Hubungi via form atau langsung ke email kami.
        </Text>
      </div>
      <div class="grid lg:grid-cols-12 mt-8">
        <form
          class="bg-dark-green p-8 lg:col-span-4 space-y-8"
          method="post"
          action="https://formsubmit.co/hello@banuadev.com"
          aria-labelledby="contact-title"
        >
          <h2 id="contact-title" class="sr-only">Form kontak</h2>
          <!-- Nama -->
          <div class="flex flex-col gap-2">
            <label for="name" class="uppercase text-white text-xs tracking-wide"
              >Nama</label
            >
            <input
              id="name"
              type="text"
              name="name"
              required
              autocomplete="name"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>
          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label
              for="email"
              class="uppercase text-white text-xs tracking-wide">Email</label
            >
            <input
              id="email"
              type="email"
              name="email"
              required
              autocomplete="email"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>
          <!-- Topik -->
          <div class="flex flex-col gap-2">
            <label
              for="topic"
              class="uppercase text-white text-xs tracking-wide">Topik</label
            >
            <select
              id="topic"
              name="topic"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            >
              <option value="general">Pertanyaan Umum</option>
              <option value="event">Event & Workshop</option>
              <option value="speaker">Jadi Speaker</option>
              <option value="sponsor">Sponsorship</option>
              <option value="collaboration">Kolaborasi</option>
            </select>
          </div>
          <!-- Pesan -->
          <div class="flex flex-col gap-2">
            <label
              for="message"
              class="uppercase text-white text-xs tracking-wide">Pesan</label
            >
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              autocomplete="off"
              class="w-full bg-black/15 border-transparent px-4 py-3 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            ></textarea>
          </div>
          <!-- Subscribe -->
          <div>
            <div class="flex items-start gap-3 text-xs text-white">
              <input
                id="subscribe"
                type="checkbox"
                name="subscribe"
                class="mt-1 border-base-400 accent-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
              />
              <label for="subscribe" class="cursor-pointer">
                Kirim saya info event dan update terbaru dari BanuaDev.
              </label>
            </div>
            <!-- Submit -->
            <Button
              type="submit"
              size="base"
              variant="muted"
              class="w-full mt-4"
            >
              Kirim Pesan
            </Button>
          </div>
        </form>
        <aside class="lg:col-span-3 lg:col-start-6">
          <div class="space-y-4">
            <Text
              tag="h2"
              variant="textXL"
              class="font-display uppercase text-black"
            >
              Kontak Langsung
            </Text>
            <dl
              class="divide-y divide-dashed divide-black/10 text-base-200 mt-8 border-y border-dashed border-black/10"
            >
              <div class="py-4">
                <dt class="font-display uppercase text-black">Email</dt>
                <dd>
                  <a class="underline text-base-600" href="mailto:hello@banuadev.com"
                    >hello@banuadev.com</a
                  >
                </dd>
              </div>
              <div class="py-4">
                <dt class="font-display uppercase text-black">Instagram</dt>
                <dd>
                  <a class="underline text-base-600" href="https://instagram.com/banuadev" target="_blank"
                    >@banuadev</a
                  >
                </dd>
              </div>
              <div class="py-4">
                <dt class="font-display uppercase text-black">Discord</dt>
                <dd>
                  <a class="underline text-base-600" href="#_"
                    >Join Server</a
                  >
                </dd>
              </div>
              <div class="py-4">
                <dt class="font-display uppercase text-black">Telegram</dt>
                <dd>
                  <a class="underline text-base-600" href="#_"
                    >Join Group</a
                  >
                </dd>
              </div>
            </dl>
          </div>
          <div class="space-y-4 border-t border-white/10 pt-6">
            <Text
              tag="h2"
              variant="textXL"
              class="font-display uppercase text-black"
            >
              Lokasi
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600">
              Kalimantan Selatan, Indonesia
            </Text>
            <Text tag="p" variant="textSM" class="text-base-600">
              Venue untuk event offline akan diumumkan sebelum setiap event.
            </Text>
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
