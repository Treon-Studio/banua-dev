---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout pageTitle="Daftar">
  <section>
    <Wrapper variant="standard" class="py-32">
      <div>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight"
        >
          Gabung Komunitas BanuaDev
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
        >
          Pilih membership yang sesuai: Community Member gratis untuk akses
          online, atau Event Pass untuk ikut meetup dan workshop offline.
          Isi form dan kami akan konfirmasi dalam 1-2 hari kerja.
        </Text>
      </div>
      <div class="grid lg:grid-cols-12 mt-8">
        <form
          class="bg-dark-green p-8 lg:col-span-4 space-y-8"
          method="post"
          action="https://formsubmit.co/hello@banuadev.com"
          aria-labelledby="registration-title"
        >
          <h2 id="registration-title" class="sr-only">
            Form registrasi member
          </h2>

          <!-- Nama Lengkap -->
          <div class="flex flex-col gap-2">
            <label for="name" class="uppercase text-white text-xs tracking-wide"
              >Nama Lengkap</label
            >
            <input
              id="name"
              type="text"
              name="name"
              required
              autocomplete="name"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="uppercase text-white text-xs tracking-wide"
              >Email</label
            >
            <input
              id="email"
              type="email"
              name="email"
              required
              autocomplete="email"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>

          <!-- No. WhatsApp -->
          <div class="flex flex-col gap-2">
            <label for="phone" class="uppercase text-white text-xs tracking-wide"
              >No. WhatsApp</label
            >
            <input
              id="phone"
              type="tel"
              name="phone"
              autocomplete="tel"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>

          <!-- Profesi -->
          <div class="flex flex-col gap-2">
            <label for="profession" class="uppercase text-white text-xs tracking-wide"
              >Profesi / Pekerjaan</label
            >
            <input
              id="profession"
              type="text"
              name="profession"
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            />
          </div>

          <!-- Membership -->
          <div class="flex flex-col gap-2">
            <label for="membership" class="uppercase text-white text-xs tracking-wide"
              >Pilih Membership</label
            >
            <select
              id="membership"
              name="membership"
              required
              class="w-full bg-black/15 border-transparent px-4 py-3 h-11 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            >
              <option value="community">Community Member — Gratis</option>
              <option value="event">Event Pass — Rp 50K/event</option>
              <option value="workshop">Workshop Pass — Rp 150K</option>
              <option value="annual">Annual Member — Rp 500K/tahun</option>
            </select>
          </div>

          <!-- Catatan -->
          <div class="flex flex-col gap-2">
            <label for="notes" class="uppercase text-white text-xs tracking-wide"
              >Catatan (opsional)</label
            >
            <textarea
              id="notes"
              name="notes"
              rows="3"
              class="w-full bg-black/15 border-transparent px-4 py-3 text-xs text-white placeholder:text-base-50 focus:border-white/60 focus:outline-none"
            ></textarea>
          </div>

          <!-- Consent + Submit -->
          <div>
            <div class="flex items-start gap-3 text-xs text-white">
              <input
                id="consent"
                type="checkbox"
                name="consent"
                required
                class="mt-1 border-base-400 accent-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
              />
              <label for="consent" class="cursor-pointer">
                Saya setuju menerima info event dan update dari tim BanuaDev.
              </label>
            </div>

            <Button
              type="submit"
              size="base"
              variant="muted"
              class="w-full mt-4 focus-visible:ring-2 focus-visible:ring-white/70"
            >
              Daftar Sekarang
            </Button>
          </div>
        </form>

        <aside class="lg:col-span-3 lg:col-start-6">
          <div class="space-y-4">
            <Text
              tag="h2"
              variant="textXL"
              class="font-display uppercase text-black"
            >
              Langkah Selanjutnya
            </Text>
            <ul
              role="list"
              class="space-y-4 text-base-600 list-decimal list-inside"
            >
              <li>
                Kami akan review pendaftaran dan konfirmasi via email dalam 1-2 hari.
              </li>
              <li>
                Kamu akan diundang ke grup Discord/Telegram komunitas.
              </li>
              <li>
                Untuk event offline, kami akan kirim detail lokasi dan jadwal.
              </li>
            </ul>
            <div class="border-t border-white/10 pt-6">
              <Text
                tag="p"
                variant="textXS"
                class="font-display uppercase text-black"
              >
                Ada pertanyaan?
              </Text>
              <Text tag="p" variant="textSM" class="text-base-600">
                Email <a
                  class="underline text-base-600"
                  href="mailto:hello@banuadev.com">hello@banuadev.com</a
                > atau hubungi via Instagram @banuadev.
              </Text>
              <Text tag="p" variant="textXS" class="mt-4 text-base-600">
                Lihat opsi membership di <a
                  class="underline"
                  href="/tickets">halaman membership</a
                >.
              </Text>
            </div>
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
