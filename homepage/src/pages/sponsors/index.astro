---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SponsorCard from "@/components/sponsors/SponsorCard.astro";
// Content
import { getCollection } from "astro:content";
const sponsors = await getCollection("sponsors");
const tierOrder = ["platinum", "gold", "silver", "bronze"];
const tierMeta = {
  platinum: {
    label: "Platinum",
    description:
      "Partner utama yang mendukung program komunitas, workshop, dan akses untuk semua member.",
  },
  gold: {
    label: "Gold",
    description:
      "Kolaborator strategis yang mendanai event, workshop, dan program khusus.",
  },
  silver: {
    label: "Silver",
    description:
      "Perusahaan teknologi dan studio yang mendukung workshop dan meetup.",
  },
  bronze: {
    label: "Bronze",
    description:
      "Pendukung komunitas yang membantu beasiswa dan akses untuk developer pemula.",
  },
};
const groupedTiers = tierOrder.flatMap((tier) => {
  const tierSponsors = sponsors.filter(
    (sponsor) => (sponsor.data.tier || "bronze") === tier
  );
  return tierSponsors.length > 0
    ? [
        {
          key: tier,
          label: tierMeta[tier]?.label || tier,
          description: tierMeta[tier]?.description || "",
          sponsors: tierSponsors,
        },
      ]
    : [];
});
const totalSponsors = sponsors.length;
const leadSponsor = sponsors.find(
  (sponsor) => sponsor.data.tier === "platinum"
);
const leadSponsorName = leadSponsor?.data.name;
const tierSummary = `${totalSponsors} sponsor mendukung BanuaDev`;
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-32">
      <div>
        <Text tag="p" variant="textXS" class="uppercase text-base-600">
          Dukungan
        </Text>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight mt-8"
        >
          Sponsor BanuaDev
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
        >
          {tierSummary}. Dari partner utama hingga pendukung komunitas,
          organisasi-organisasi ini membantu kami mengadakan program yang
          bermanfaat untuk developer di Kalimantan Selatan.
        </Text>
      </div>
      <Text tag="p" variant="textXS" class="uppercase text-black mt-24">
        Partner utama: {leadSponsorName}
      </Text>
      <div class="space-y-24 lg:space-y-48 mt-8">
        {
          groupedTiers.map((tier) => (
            <div class="grid grid-cols-1 lg:grid-cols-12">
              <div class="lg:col-span-3">
                <Text
                  tag="h2"
                  variant="displaySM"
                  class="font-display   uppercase text-black"
                >
                  {tier.label}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-600 text-balance mt-1"
                >
                  {tier.description}
                </Text>
              </div>
              <div class="grid  md:grid-cols-2 lg:grid-cols-4 mt-4 lg:col-span-9 ">
                {tier.sponsors.map((sponsor) => (
                  <SponsorCard sponsor={sponsor} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <section
        class="gap-x-12 gap-y-8 border border-white/10 bg-dark-green p-8 md:flex md:items-center md:justify-between mt-24"
      >
        <div class="max-w-2xl space-y-4">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-display uppercase text-white"
          >
            Jadi Sponsor
          </Text>
          <Text tag="p" variant="textSM" class="text-base-200 lg:text-balance">
            Tertarik mendukung komunitas developer Kalimantan Selatan? Kami
            menawarkan paket sponsorship untuk perusahaan teknologi, startup,
            dan organisasi. Email <a class="underline" href="mailto:hello@banuadev.com"
              >hello@banuadev.com</a
            > untuk info lebih lanjut.
          </Text>
        </div>
        <div
          class="flex flex-wrap items-center justify-center gap-2 md:justify-end"
        >
          <Button
            size="sm"
            variant="default"
            class="w-fit"
            href="mailto:hello@banuadev.com"
          >
            Hubungi Kami
          </Button>
          <Button
            size="sm"
            variant="muted"
            class="w-fit"
            href="/forms/contact"
          >
            Info Sponsorship
          </Button>
        </div>
      </section>
    </Wrapper>
  </section>
</BaseLayout>
