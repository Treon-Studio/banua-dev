---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";

const faqSections = [
  {
    title: "Umum",
    faqs: [
      {
        question: "Apa itu BanuaDev?",
        answer:
          "BanuaDev adalah komunitas developer Indonesia yang fokus pada sharing knowledge, networking, dan pengembangan skill bersama. Kami mengadakan meetup, workshop, dan berbagai event untuk membantu developer berkembang.",
      },
      {
        question: "Siapa yang bisa bergabung?",
        answer:
          "Semua orang yang tertarik dengan teknologi dan software development! Mulai dari pemula, mahasiswa, profesional, hingga tech lead. Tidak ada batasan skill level untuk bergabung.",
      },
      {
        question: "Bagaimana cara bergabung?",
        answer:
          "Kamu bisa langsung bergabung ke Discord atau Telegram kami secara gratis. Untuk event offline, pantau jadwal di website dan daftar melalui form registrasi.",
      },
    ],
  },
  {
    title: "Event & Workshop",
    faqs: [
      {
        question: "Event apa saja yang diadakan?",
        answer:
          "Kami mengadakan meetup bulanan, workshop intensif, hackathon, dan sharing session. Topik yang dibahas beragam mulai dari web development, mobile, cloud, AI/ML, hingga soft skills.",
      },
      {
        question: "Apakah event berbayar?",
        answer:
          "Sebagian besar meetup gratis untuk member. Workshop intensif biasanya berbayar untuk menutupi biaya venue dan konsumsi. Member tahunan mendapat diskon khusus.",
      },
      {
        question: "Bagaimana jika tidak bisa hadir offline?",
        answer:
          "Beberapa event kami hybrid (offline + online). Rekaman juga biasanya tersedia di channel komunitas untuk yang tidak bisa hadir langsung.",
      },
    ],
  },
  {
    title: "Membership",
    faqs: [
      {
        question: "Apa benefit menjadi member?",
        answer:
          "Member mendapat akses ke Discord eksklusif, diskon workshop, prioritas registrasi event, dan akses ke mentoring session dengan praktisi industri.",
      },
      {
        question: "Bagaimana cara menjadi member?",
        answer:
          "Kamu bisa mendaftar melalui halaman membership di website kami. Pembayaran bisa dilakukan via transfer bank atau e-wallet.",
      },
      {
        question: "Apakah membership bisa di-refund?",
        answer:
          "Membership bisa di-refund dalam 7 hari pertama jika kamu merasa tidak cocok. Setelah itu, tidak ada refund tapi kamu tetap bisa menggunakan benefit sampai masa berlaku habis.",
      },
    ],
  },
  {
    title: "Kontribusi",
    faqs: [
      {
        question: "Bagaimana cara menjadi speaker?",
        answer:
          "Kami selalu terbuka untuk speaker baru! Submit proposal topik melalui form di website atau hubungi tim kami langsung. Tidak harus expert, yang penting mau berbagi.",
      },
      {
        question: "Bisa jadi volunteer atau organizer?",
        answer:
          "Tentu! Kami butuh bantuan untuk berbagai hal seperti dokumentasi, moderasi komunitas, dan organizing event. Hubungi kami jika tertarik berkontribusi.",
      },
      {
        question: "Bagaimana cara sponsorship?",
        answer:
          "Untuk partnership dan sponsorship, silakan hubungi kami di hello@banuadev.com. Kami terbuka untuk kolaborasi dengan perusahaan dan organisasi.",
      },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 items-start">
        <div class="pb-8 lg:col-span-8">
          <Text
            tag="h1"
            variant="displayMD"
            class="text-balance text-accent-500 font-display uppercase leading-tight"
          >
            Frequently Asked Questions
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="text-base-600 font-medium max-w-2xl mt-2 text-balance"
          >
            Punya pertanyaan tentang BanuaDev? Cek jawaban di bawah. Masih ada yang belum jelas? Hubungi kami di
            <a
              class="underline hover:text-accent-500"
              href="mailto:hello@banuadev.com">hello@banuadev.com</a
            >
          </Text>
        </div>
        <div
          aria-hidden="true"
          class="hidden lg:grid grid-cols-2 lg:grid-cols-4 *:p-8 *:aspect-square *:bg-accent-500 *:flex lg:col-span-4"
        >
          <div></div>
          <div class="lg:col-start-3"></div>
          <div></div>
          <div class="lg:col-start-3"></div>
        </div>
      </div>

      <div class="space-y-12 bg-accent-500">
        {
          faqSections.map((section) => (
            <section class="border-y border-dashed border-black/10">
              <header class="border-b border-black/10 border-dashed px-6 py-6 sm:px-10">
                <Text
                  tag="h2"
                  variant="displaySM"
                  class="font-display uppercase text-white"
                >
                  {section.title}
                </Text>
              </header>

              <ul class="divide-y divide-black/10 divide-dashed">
                {section.faqs.map((faq) => (
                  <li class="px-6 py-6 sm:px-10">
                    <details class="group">
                      <summary class="flex cursor-pointer items-center justify-between gap-6 text-left font-display text-lg uppercase text-white transition hover:text-white">
                        <span>{faq.question}</span>
                        <span class="text-white transition group-open:rotate-45 text-xl">
                          +
                        </span>
                      </summary>
                      <div class="mt-4 border-l border-white pl-4 text-base-200">
                        <Text tag="p" variant="textLG" class="text-base-200">
                          {faq.answer}
                        </Text>
                      </div>
                    </details>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
