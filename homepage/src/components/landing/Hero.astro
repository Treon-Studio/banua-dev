---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-32 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-end">
      <div class="lg:col-span-8 pb-8">
        <Text
          tag="h1"
          variant="displayMD"
          class="text-balance text-black font-display uppercase leading-tight"
        >
          BanuaDev — Komunitas Developer Kalimantan Selatan
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-black/70 font-medium max-w-2xl mt-2 text-balance"
        >
          Komunitas developer dari Bumi Banua. Belajar bersama, berbagi pengalaman,
          dan berkembang bersama dalam dunia teknologi di Kalimantan Selatan.
        </Text>
        <Button size="sm" variant="accent" href="/forms/register" class="w-fit mt-8">
          Gabung Komunitas
        </Button>
      </div>
      <div
        aria-hidden="true"
        class="hidden lg:grid grid-cols-2 lg:grid-cols-4 *:p-8 *:aspect-square *:bg-dark-green *:flex lg:col-span-4 *:size-full"
      >
        <div class="lg:col-start-2"></div>
        <div class="lg:col-start-4"></div>
        <div></div>
        <div></div>
      </div>
    </div>
    <div
      aria-hidden="true"
      class="w-full h-full relative lg:col-span-5 bg-dark-green h-full p-20 p-4 aspect-16/4"
    >
    
    </div>
  </Wrapper>
</section>
