---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const sessions = await getCollection("sessions");
const speakers = await getCollection("speakers");
// Calculate unique days from sessions
const daysSet = new Set(
  sessions.map((s) => new Date(s.data.start).toISOString().slice(0, 10))
);
const numDays = daysSet.size;
const numSpeakers = speakers.length;
const highlights = [
  {
    number: numDays,
    label: "Events",
    description: `Ikuti ${numDays} event komunitas kami. Mulai dari meetup, workshop, hingga hackathon yang dirancang untuk mengembangkan skill dan memperluas jaringan.`,
    button: { label: "Lihat Jadwal", href: "/schedule" },
  },
  {
    number: sessions.length,
    label: "Sessions",
    description: `Eksplorasi ${sessions.length} sesi pembelajaran tentang berbagai topik teknologi. Dari web development, mobile, cloud, hingga AI/ML.`,
    button: { label: "Lihat Sessions", href: "/schedule" },
    gradient: "",
  },
  {
    number: numSpeakers,
    label: "Speakers",
    description: `Belajar dari ${numSpeakers} praktisi dan expert di bidangnya. Dapatkan insight langsung dari mereka yang sudah berpengalaman di industri.`,
    button: { label: "Lihat Speakers", href: "/speakers" },
  },
];
const eventHighlights = [
  {
    title: "Meetup Bulanan",
    description: "Sharing & networking",
  },
  {
    title: "Workshop Praktis",
    description: "Hands-on learning",
  },
  {
    title: "Online Community",
    description: "Diskusi & kolaborasi",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid grid-cols-1 lg:grid-cols-9">
      <div class="lg:col-span-9">
        <Text
          tag="h2"
          variant="displaySM"
          class="text-balance text-accent-500 font-display uppercase leading-tight"
        >
          Komunitas untuk Developer
        </Text>
        <ul class="grid grid-cols-1 lg:grid-cols-9 mt-4">
          {
            eventHighlights.map((item) => (
              <li class="lg:col-span-3">
                <Text
                  variant="textBase"
                  tag="h3"
                  class="text-accent-500 font-medium"
                >
                  {item.title}
                </Text>
                <Text tag="p" variant="textSM" class="text-base-500 ">
                  {item.description}
                </Text>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div
      class="grid grid-cols-1 items-start gap-y-12 xl:grid-cols-12 mt-12"
    >
      {
        highlights.map((item) => (
          <div class="flex flex-col items-start justify-between gap-8 pt-20 md:pt-48  h-full [&:nth-child(1)]:lg:col-start-2 [&:nth-child(2)]:lg:col-start-6 relative  lg:col-span-3">
            <div class="w-full ">
              <Text
                tag="p"
                variant="display6XL"
                class="text-base-900 font-display font-thin lg:text-right absolute top-0 md:right-0 md:text-[20rem] xl:text-[25rem] md:opacity-6 md:-top-14"
              >
                {item.number}
              </Text>
              <div class="lg:pr-8 mt-4 lg:mt-0 realtive w-full">
                <Text
                  tag="h3"
                  variant="textXL"
                  class="text-accent-500  font-display uppercase"
                >
                  {item.label}
                </Text>
                <Text tag="p" variant="textBase" class="text-base-500 ">
                  {item.description}
                </Text>
              </div>
            </div>
            <a
              href={item.button.href}
              class="text-accent-500 font-medium underline text-sm"
            >
              {item.button.label}
            </a>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
